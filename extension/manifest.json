{
  "manifest_version": 3,
  "name": "TaskFlow",
  "version": "1.1.0",
  "description": "TaskFlow — tasks, Pomodoro timer, quick notes, and more in every tab",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://uid.varshitreddy.me/*", "http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
